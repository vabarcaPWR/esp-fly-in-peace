# sdkconfig.defaults — esp-fly-in-peace
# Optimal settings for ESP32-C3 Super Mini with NimBLE

# --- BLE: NimBLE stack (lighter than Bluedroid) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

# --- CPU frequency ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# --- FreeRTOS: 1 ms tick for precise timing ---
CONFIG_FREERTOS_HZ=1000

# --- Flash: 4 MB ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Baro: MS5611 ---
CONFIG_SENSOR_MS5611=y

# --- ESP32-C3 Super Mini GPIO defaults ---
CONFIG_SENSOR_I2C_SDA_GPIO=6
CONFIG_SENSOR_I2C_SCL_GPIO=7

# --- IMU: MPU6050 ---
CONFIG_IMU_MPU6050=y

# --- Sound: Piezo buzzer ---
CONFIG_SOUND_PIEZO=y
CONFIG_PIEZO_GPIO=5

# --- Log level: INFO (default) ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# --- Power management ---
CONFIG_PM_ENABLE=y

# --- Watchdog: extend task WDT for debug sessions ---
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
