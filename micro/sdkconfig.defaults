# sdkconfig.defaults — esp-fly-in-peace
# Optimal settings for ESP32-C3 DevKitC-02 v1.1 with NimBLE

# --- BLE: NimBLE stack (lighter than Bluedroid) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

# --- CPU frequency ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# --- FreeRTOS: 1 ms tick for precise timing ---
CONFIG_FREERTOS_HZ=1000

# --- Flash: 4 MB (DevKitC-02 v1.1) ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Log level: INFO (default) ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# --- Power management ---
CONFIG_PM_ENABLE=y

# --- Watchdog: extend task WDT for debug sessions ---
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
